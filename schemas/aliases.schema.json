{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/powder-nomad/open-ski-data/main/schemas/aliases.schema.json",
  "title": "registry/aliases.json",
  "description": "Slug rename ledger. Append-only — every entry is part of the authoritative history that downstream consumers (Ridgecast, SkiWatch) reconcile against.",
  "type": "object",
  "additionalProperties": true,
  "required": ["renames"],
  "properties": {
    "$comment": { "type": "string" },
    "renames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "at"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Legacy slug (kebab-case)."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Canonical slug (kebab-case). Must match the place_slug used in registry/<country>/<region>/<slug>/place.json."
          },
          "at": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date the rename was first published, ISO 8601 (YYYY-MM-DD)."
          }
        }
      }
    }
  }
}
