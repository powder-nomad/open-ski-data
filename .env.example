# open-ski-data editor — env template
# Copy to .env.local for dev; configure in CF Pages dashboard for production.

# ─── GitHub OAuth ───────────────────────────────────────────────────
# Register at https://github.com/settings/developers (Paul's account).
# - Application name: open-ski-data editor
# - Homepage URL: https://<your-domain>/
# - Authorization callback URL: https://<your-domain>/api/auth/github/callback
# - Scope to request at runtime: public_repo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32-byte hex string used to HMAC-sign the session cookie (Web Crypto).
# Generate locally: openssl rand -hex 32
SESSION_SECRET=

# ─── Google Maps (client-side renderer) ─────────────────────────────
# Restrict by HTTP referrer in Google Cloud Console:
#   - https://<your-domain>/*
#   - https://*.<project>.pages.dev/*  (Pages preview deploys)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional client-side Map ID (vector styling). Same project as the key above.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ─── Google Maps Elevation API (server-side proxy) ──────────────────
# Kept off the bundle — used by /api/elevation only. Same project,
# different referrer policy (server-side, no referrer restriction).
GOOGLE_ELEVATION_API_KEY=

# ─── Optional ───────────────────────────────────────────────────────
# Override the upstream repo for local testing. Defaults to
# powder-nomad/open-ski-data (hard-coded in src/lib/github-client.ts).
# UPSTREAM_OWNER=powder-nomad
# UPSTREAM_REPO=open-ski-data
